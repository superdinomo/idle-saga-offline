					<e:Label size="20" textAlign="center" verticalAlign="middle" fontFamily="Times" x="27" text="Sound" y="107" textColor="0xCDC8B1"/>
					<e:HSlider id="sliderYinxiao" x="75" y="99" width="360" maximum="10" skinName="SettingHSliderEUI" value="0"/>
				</e:Group>
				<e:Group y="489" width="479" horizontalCenter="0">
