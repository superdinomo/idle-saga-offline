	<w:Config id="1586b13ea96" />
	<e:Group height="882" horizontalCenter="7.5" verticalCenter="59" width="545">
		<e:Image x="0" y="-1" source="public_zycs_bg2_png"/>
		<e:Button id="closeBtn" label="" x="453" y="39" skinName="Btn0Skin" icon="public_zycs_quxiao"/>
		<e:Image y="19" horizontalCenter="2" source="zlxz_zycs_msz"/>
		<e:Image y="96" horizontalCenter="7.5" source="zlxz_zycs_msz1"/>
