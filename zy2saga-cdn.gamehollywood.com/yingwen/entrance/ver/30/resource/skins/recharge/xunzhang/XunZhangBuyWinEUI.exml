		<e:Image y="500" x="23" source="hjsl_zycs_sf"/>
		<e:Image y="488" x="231" source="zlxz_zycs_jt"/>
		<e:Image y="528" x="237" source="zlxz_zycs_zsjn"/>
		<e:Group id="entityGroup" x="140" y="483" y.buy="414" y.receive="414"/>
		<e:Scroller y="295" height="251" width="336.12" anchorOffsetY="0" anchorOffsetX="0" x="256" scaleY="0.85" scaleX="0.85">
			<e:List id="list" itemRendererSkinName="ItemSkin" anchorOffsetX="0" width="553">
			
				
				
				
				
				
				
				
				
			
				<e:layout>
					<e:TileLayout paddingLeft="5" paddingTop="5" paddingBottom="5" paddingRight="5" horizontalGap="14" verticalGap="20"/>
				</e:layout>
			</e:List>
		</e:Scroller>
		<e:Image y="498" x="15" source="zlxz_zycs_zl"/>
