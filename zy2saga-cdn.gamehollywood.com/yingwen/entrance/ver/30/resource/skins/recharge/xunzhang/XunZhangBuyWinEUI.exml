				<e:HorizontalLayout verticalAlign="middle"/>
			</e:layout>
		</e:Group>
		<e:Label text="The rebated vouchers won't affect the daily acquire limit" y="594" size="20" fontFamily="Times" textColor="0xE3D7BE" scaleX="1" scaleY="1" right="18"/>
	</e:Group>
</e:Skin>