<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="ShengbeiTipsWinEUI" width="720" height="1280" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:euiextension="euiextension.*" xmlns:ns1="*">
	<w:Config id="1586b3502a7" />
	<e:Group id="group" width="520" height="914" verticalCenter="12" horizontalCenter="0">
		<e:Image id="background0" width="100%" scale9Grid="26,25,5,5" source="public_zycs_nt" touchEnabled="false"
		         height="940" horizontalCenter="0"  anchorOffsetY="0"/>
		<e:Group>
			<e:Image id="imgQualityBg" anchorOffsetX="0" source="zbxx_zycs_5" x="3" y="3" />
			<e:Image y="15" source="tips_zycs_di" horizontalCenter="0" />
			<e:Label id="labelName" text="Undying Grail" y="24" fontFamily="Times" size="24" anchorOffsetX="0" textAlign="left"
			         textColor="0xcd8cff" x="211" />
			<e:Label y="65" text="Gear CP" fontFamily="Times" size="24" x="125" textColor="0xff9b0f" />
			<e:Image y="96" source="public_zycs_jlylk"  x="146"/>
			<e:Group id="groupPower" y="111" horizontalCenter="42">
				<e:Image x="0" y="2" source="public_zycs_zdl" />
				<e:BitmapLabel id="bmpLabelPower" x="116" y="0" text="12" font="powernum_fnt" />
				<e:layout>
					<e:HorizontalLayout verticalAlign="middle" />
				</e:layout>
			</e:Group>
			<e:Component id="itemIcon" x="20" y="64" skinName="ItemSkin" />
		</e:Group>
		<e:Group id="groupShengbei" x="0" y="226" width="520">
			<e:Image x="4" y="0" source="zbxx_zycs_xj" />
			<e:Label y="7" text="Holy Grail Stats" fontFamily="Times" size="20" x="26" textColor="0xFF9B0F" />
			<e:Scroller width="466" height="200" x="27" y="43">
				<e:List id="listAttrShengbei" x="0" y="1" width="100%" height="100%" itemRendererSkinName="ShengbeiTipsWinItemBeiEUI">
					<!--
						
							
							
							
							
						
					-->
					<e:layout>
						<e:VerticalLayout gap="2" />
					</e:layout>
				</e:List>
			</e:Scroller>
		</e:Group>
		<e:Group id="groupStone" x="0" y="475" width="520" anchorOffsetY="0" height="299">
			<e:Image x="4" y="0" source="zbxx_zycs_xj" />
			<e:Label y="7" text="Originite Stats" fontFamily="Times" size="20" x="26" textColor="0xFF9B0F" />
			<e:Scroller width="487" height="259" x="16" y="36" anchorOffsetX="0" anchorOffsetY="0">
				<e:List id="listAttrStone" x="0" y="-5" width="100%" height="215" itemRendererSkinName="ShengbeiTipsWinItemStoneEUI" anchorOffsetY="0">
					<!--
						
							
							
							
							
						
					-->
					<e:layout>
						<e:VerticalLayout gap="3" />
					</e:layout>
				</e:List>
			</e:Scroller>
		</e:Group>
		<e:Group id="groupSkill" width="520" height="153" x="0" y="780" anchorOffsetY="0">
			<e:Image x="4" y="0" source="zbxx_zycs_xj" />
			<e:Label y="7" text="Exclusive Skill" fontFamily="Times" size="20" x="26" textColor="0xFF9B0F" />
			<e:Image x="20" y="51" source="public_zycs_daojukuang_01"/>
			<e:Image id="imgSkillIcon" x="27" y="56" source="public_zycs_daojukuang_01" width="80" height="80"/>
			<e:Label id="labelSkillName" text="Skill Name" y="47" size="24" fontFamily="Times" textAlign="left" x="127" scaleX="1"
			         scaleY="1" textColor="0xff9b0f" />
			<e:Label id="labelSkillDesc" text="0" y="79" size="18" fontFamily="Times" textAlign="left" x="127"
			         textColor="0xFF9B0F"  width="380"/>
		</e:Group>
		<e:Image id="background" width="518" source="public_zycs_wk" touchEnabled="false" height="944" y="-1" scale9Grid="26,21,5,9" anchorOffsetY="0"/>
		<e:Label id="closeBtn" text="Tap blank space to close" y="950" size="20" fontFamily="Times" textAlign="left" textColor="0x888786" touchEnabled="true" horizontalCenter="0"/>
		<e:Button id="closeBtn0" skinName="Btn0Skin" icon="public_zycs_cha" right="4" top="4" x="485" y="0" scaleX="1" scaleY="1"/>
	</e:Group>
</e:Skin>