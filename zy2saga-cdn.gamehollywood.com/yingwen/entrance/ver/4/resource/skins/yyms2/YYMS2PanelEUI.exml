		<e:Image y="-64" touchEnabled="false" pixelHitTest="true" x="-2" source="dljl_zycs_k_png" />
		<e:Image touchEnabled="false" pixelHitTest="true" y="-12" horizontalCenter="0"
		          source="bt_zycs_zsmiaosha"/>
			<e:List id="listTab" itemRendererSkinName="YYMS2TabItemEUI" y="60" horizontalCenter="0">
				<e:layout>
					<e:HorizontalLayout gap="56" />
				</e:layout>
				<!--
				-->
			</e:List>
		<e:Group id="groupBoxEff" width="0" height="0" y="435" horizontalCenter="0"/>
