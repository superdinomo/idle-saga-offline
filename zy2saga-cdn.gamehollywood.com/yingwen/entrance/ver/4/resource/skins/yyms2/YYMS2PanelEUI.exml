		<e:Image id="imgBoxTips" x="524" y="263"  source="zsms_zycs_10000"/>
		<e:Image id="imgBox"  bottom="614" horizontalCenter="0" source="yyms2_zycs_box1"/>
			<e:Button id="btnLeft" label="" x="136" y="467" skinName="Btn0Skin" icon="zuji_zycs_jiantou" scaleY="1" scaleX="-1" />
		<e:Button id="btnRight" label="" x="584" y="467" skinName="Btn0Skin" icon="zuji_zycs_jiantou" />
		<e:Image x="122" y="603" source="liuguang_zycs_huawen" />
		<e:Image x="312" y="602"  source="yyms_zycs_lbnr"/>
		<e:Image x="599" y="603" source="liuguang_zycs_huawen" scaleX="-1" />
		<e:Scroller horizontalCenter="0" y="624">
			<e:List id="listAward" itemRendererSkinName="ItemSkin">
				<e:layout>
					<e:HorizontalLayout gap="12"  paddingLeft="6" paddingTop="6" paddingBottom="40"/>
