					<e:Object/>
					<e:Object/>
					<e:Object/>
					<e:Object/>
				</e:ArrayCollection>-->
			</e:List>
		</e:Scroller>
		<e:Label id="lbDesc" text="Purchase Lv.10 to upgrade to Lv.10" y="587" size="20" fontFamily="Times" horizontalCenter="-1"
		         textColor="0xe3d7be" />
		<e:Group y="619" width="364" horizontalCenter="0">
			<e:Image id="sub10Btn" source="public_zycs_jians" />
			<e:Image id="sub1Btn" source="public_zycs_j"  left="68"/>
			<e:Image id="inputback" y="3" width="128" height="38" scale9Grid="6,6,3,3"
			         source="public_zycs_shurukuang"  horizontalCenter="0"/>
			<e:Image id="add1Btn" source="public_zycs_jia"  right="68"/>
			<e:Image id="add10Btn" source="public_zycs_jias"  right="0"/>
			<e:Label id="numLabel" text="0" y="10.85" size="20" fontFamily="Times" anchorOffsetX="0" width="89"
			         anchorOffsetY="0" height="19" textAlign="center" horizontalCenter="0" />
		</e:Group>
		<e:Component id="allPrice" y="668" skinName="PriceIconSkin" scaleX="1" scaleY="1"  horizontalCenter="0"/>
		<e:Button id="buyBtn" label="Purchase" y="708" skinName="BtnMin1_2"  horizontalCenter="0.5"/>
	</e:Group>
</e:Skin>