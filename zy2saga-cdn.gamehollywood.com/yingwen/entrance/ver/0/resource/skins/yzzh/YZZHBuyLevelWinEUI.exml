					<e:Object/>
					<e:Object/>
					<e:Object/>
					<e:Object/>
				</e:ArrayCollection>-->
			</e:List>
		</e:Scroller>
		<e:Label text="Activate Warrior Badge to claim the following items" y="363" size="20" fontFamily="Times" horizontalCenter="-1" textColor="0xE3D7BE" />
		<e:Scroller y="387" scrollPolicyH="off" height="204" width="520" scaleX="0.9"
		            scaleY="0.9" horizontalCenter="0">
			<e:List id="list2" itemRendererSkinName="ItemSkin">
				<e:layout>
					<e:TileLayout horizontalGap="8" verticalGap="12" requestedColumnCount="5" paddingLeft="12" paddingRight="12"
					              paddingTop="12"  paddingBottom="0"/>
				</e:layout>
				<!--<e:ArrayCollection>
					<e:Object/>
					<e:Object/>
					<e:Object/>
					<e:Object/>
