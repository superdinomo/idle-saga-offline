<e:Skin class="YZZHBuyLevelWinEUI" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"
        height="1280" width="720">
	<w:Config id="1586b1383e3" />
	<e:Group id="group" verticalCenter="32" width="578" height="838" horizontalCenter="0">
		<e:Image x="0" y="0" scale9Grid="90,70,15,6" source="yzsh_zycs_gmbg_png" />
		<e:Button id="closeBtn" label="" x="479" y="13" skinName="Btn0Skin" icon="public_zycs_quxiao" />
		<e:Label id="lbLevelDesc" text="Upgrade to Lv.10 to gain the following rewards" y="120" size="20" fontFamily="Times" horizontalCenter="5" textColor="0xE3D7BE" />
		<e:Scroller y="144" scrollPolicyH="off" height="204" width="520" horizontalCenter="0" scaleX="0.9" scaleY="0.9">
			<e:List id="list1" itemRendererSkinName="ItemSkin">
				<e:layout>
					<e:TileLayout horizontalGap="8" verticalGap="14" requestedColumnCount="5" paddingLeft="12" paddingRight="12"
					              paddingTop="12"  paddingBottom="12"/>
				</e:layout>
				<!--<e:ArrayCollection>
					<e:Object/>
