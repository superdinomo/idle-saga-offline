	<e:BitmapLabel id="bmpRound" y="79" text="99" font="djflnum_fnt" letterSpacing="-3" left="195"/>
	<e:BitmapLabel id="bmpPrice" y="141" text="99" font="djflnum_fnt" letterSpacing="-3" scaleX="0.9" scaleY="0.9" left="600"/>
	<e:BitmapLabel id="bmpDiamond" y="207" text="9999" font="djflnum_fnt" letterSpacing="-2" right="515" scaleX="0.9" scaleY="0.9"/>
	<e:BitmapLabel id="bmpCoupon" y="207" text="19999" font="djflnum_fnt" letterSpacing="-2" scaleX="0.9" scaleY="0.9" horizontalCenter="66.5"/>
	<e:BitmapLabel id="bmpMultiple" y="142" text="999" font="djflnum_fnt" letterSpacing="-2" right="415"/>
