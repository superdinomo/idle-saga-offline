			<e:HorizontalLayout horizontalAlign="center" verticalAlign="middle" gap="9"/>
		</e:layout>
	</e:Group>
	<e:Label id="lbState" text="Not activated" fontFamily="Times" size="22" textColor="0xE6DCB8" textAlign="left" text.get="Activated" text.act="Activateable" textColor.act="0x3091ff" textColor.get="0x5ac832" verticalCenter="0" right="14"/>

