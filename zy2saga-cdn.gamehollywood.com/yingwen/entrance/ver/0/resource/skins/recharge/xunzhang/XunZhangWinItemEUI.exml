<e:Skin class="XunZhangWinItemEUI" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"  width="640" height="44"  states="noact,act,get" >
	<e:Group x="10" verticalCenter="0">
