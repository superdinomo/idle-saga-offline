			</e:skinName>
		</e:ToggleButton>
		<e:Image id="imgBianShenHead" x="10" y="40" source=""/>
		<e:BitmapLabel id="bitBianShenTime" font="zdldownnum_fnt" text="" horizontalCenter="-11" verticalCenter="15" touchEnabled="false"/>
		<e:Image id="imgAutoLock" x="9" y="38" touchEnabled="false" anchorOffsetX="0" anchorOffsetY="0" visible.openshenmo="false" visible.hideAutobtn="false" source="mianui_zycs_lock"/>
