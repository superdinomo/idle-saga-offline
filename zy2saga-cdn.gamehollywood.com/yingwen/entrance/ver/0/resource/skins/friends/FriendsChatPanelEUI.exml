			<!--
				
					
					
				
			-->
		</e:List>
	</e:Scroller>
	<e:Button id="btn_send" label="Send" y="1028" x="557" skinName="BtnMin1_1mid" height="47" width="119"/>
	<e:Button id="btn_add" x="37" y="1028" label="Follow" skinName="BtnMin1_1mid" width="119" height="47"/>
	<e:Button id="btn_delete" x="174" y="1028" label="Block" skinName="BtnMin1_1mid" width="119" height="47"/>
	<e:Image width="200" x="335" height="27" y="1038" source="public_zycs_shurukuang" scale9Grid="11,9,96,10"/>
	<e:EditableText id="editText_input" text="" prompt="Please enter" size="20" textAlign="left" verticalAlign="middle" fontFamily="Times" x="340" y="1042" width="194" textColor="0x505050" height="20"/>
