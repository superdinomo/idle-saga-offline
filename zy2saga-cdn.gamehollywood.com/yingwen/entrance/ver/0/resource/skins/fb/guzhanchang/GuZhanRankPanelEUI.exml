	<e:Label text="Ranking Description" fontFamily="Times" size="24" textAlign="center" y="792" textColor="0xF5E65A" horizontalCenter="0" />
	<e:Label id="lbDesc1" text="1. During the event period, reach the enemy elimination amount, and the ranking will be sorted in a temporal order" fontFamily="Times" size="20" textAlign="left" y="820" x="54"
	         textColor="0xe3d7be"  width="597"/>
	<e:Label id="lbDesc2" text="2. When you reach the first place for 10 times, you can gain special title" fontFamily="Times" size="20" textAlign="center" y="866" x="54"
	         textColor="0xe3d7be" />
	<e:Label id="lbDesc3" text="3. When you take part in the event for 100 times, you can gain special title" fontFamily="Times" size="20" textAlign="center" y="892" x="54"
	         textColor="0xe3d7be" />
	<e:ProgressBar id="barFirstCount" slideDuration="0" value="1" maximum="2" y="946" x="58" skinName="ProgressBarEUI12"
