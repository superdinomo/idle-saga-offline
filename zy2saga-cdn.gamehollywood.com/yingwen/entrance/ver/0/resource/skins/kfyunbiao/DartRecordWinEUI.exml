		<e:Scroller name="Personal Info" width="680" height="682" y="73" horizontalCenter="0" x="20" scaleX="1" scaleY="1">
			<e:List id="eList" x="10" itemRendererSkinName="DartRecordWinItemEUI">
				<e:layout>
					<e:VerticalLayout gap="0" />
				</e:layout>
				<!--<e:ArrayCollection>
				<e:Object/>
				<e:Object/>
			</e:ArrayCollection>-->
		</e:List>
	</e:Scroller>
		<e:Image y="756" source="role_zycs_tb2" horizontalCenter="0"/>
	<e:TabBar id="tabBar" width="260" height="52" y="774"  horizontalCenter="0" itemRendererSkinName="XunBaoJiLuBtnEUI" selectedIndex="0">
			<e:ArrayCollection>
				<e:Object labelDisplay="Guild"/>
				<e:Object labelDisplay="Personal"/>
			</e:ArrayCollection>
		<e:layout>
			<e:HorizontalLayout gap="12"/>
