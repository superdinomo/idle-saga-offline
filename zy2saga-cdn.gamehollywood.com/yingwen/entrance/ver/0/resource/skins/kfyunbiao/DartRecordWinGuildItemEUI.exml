	<e:Label id="labelInfo" x="31" size="24" text="You have already reached the destination. It has been taken down for 4 times in total" verticalAlign="middle" y="64" lineSpacing="2" fontFamily="Times" textColor="0xf01414" textColor.setout="0xff9b0f" text.setout="Set out Now" textColor.break="0xffffff" text.break="looted the treasure of our guild" width="637" y.end="59"/>
