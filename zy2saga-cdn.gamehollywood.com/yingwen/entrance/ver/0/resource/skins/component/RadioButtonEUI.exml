<?xml version="1.0" encoding="utf-8"?>
<e:Skin class="RadioButtonEUI" states="up,down,disabled,upAndSelected,downAndSelected,disabledAndSelected" xmlns:e="http://ns.egret.com/eui">
    <e:Group width="100%" height="100%">
        <e:layout>
            <e:HorizontalLayout verticalAlign="middle"/>
        </e:layout>
        <e:Image fillMode="scale" alpha="1" alpha.disabled="0.5" alpha.down="0.7"
                 source.upAndSelected="peiyang_zycs_liang"
                 source.downAndSelected="peiyang_zycs_liang"
                 source.disabledAndSelected="peiyang_zycs_liang" source="peiyang_zycs_hui"/>
        <e:Label id="labelDisplay" size="18"
                 textAlign="center" verticalAlign="middle"
                 fontFamily="Times" textColor="0xdc9623"/>
    </e:Group>
</e:Skin>
