	<e:Image source="dljl_zycs_k_png" x="-2" y="-58" touchEnabled="false" pixelHitTest="true"/>
	<e:Image id="imgTitle" y="-6" pixelHitTest="true" touchEnabled="false" horizontalCenter="0" source="yqhl_zycs_t_yqhl"/>
	<e:Image y="110" x="289" source="zbrl_zycs_xx"/>
	<e:Image y="157" x="289" source="zbrl_zycs_xx"/>
	<e:Label text="On the 1-7th day after the server opening, based on player’s successful attempts to share to friends" y="111" fontFamily="Times" size="20" textAlign="center" x="320" textColor="0xffffff"/>
	<e:Label text="Ranking rewards will be issued via mail upon the end of the event!" y="135" fontFamily="Times" size="20" textColor="0xFFFFFF" textAlign="center" x="320"/>

	<e:Group x="320" y="159">
		<e:Label text="Friend needs to log in to the game after sharing" y="0" fontFamily="Times" size="20" textAlign="center" x="0" textColor="0x13EE22"/>
		<e:Label text="to be counted as successful share!" y="0" fontFamily="Times" size="20" textColor="0xFFFFFF" textAlign="center" x="180"/>
		<e:layout>
			<e:HorizontalLayout gap="0"/>
		</e:layout>
	</e:Group>
	<e:Image y="212" x="379" source="public_zycs_gth"/>
	<e:Group x="420" y="221">
		<e:Label text="Event Countdown:" y="0" fontFamily="Times" size="20" textColor="0xFFFFFF" textAlign="center" x="0"/>
		<e:Label id="lbTime" text="00:00:00" fontFamily="Times" size="20" textAlign="center" y="0" x="128" textColor="0x13ee22"/>
		<e:layout>
			<e:HorizontalLayout gap="0"/>
		</e:layout>
	</e:Group>
	<e:Component id="itemRank1" x="8" y="313" skinName="WxYqhlRankItemTopEUI"/>
