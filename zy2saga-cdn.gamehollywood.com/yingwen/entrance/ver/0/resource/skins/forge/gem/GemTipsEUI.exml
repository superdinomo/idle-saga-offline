			<e:Label y="110" text="Gem" fontFamily="Times" size="22" x="163" textColor="0xCDC8BE" />
			<e:Label id="LabelScore" y="144" text="0" fontFamily="Times" size="22" x="164" textColor="0xCDC8BE" />
