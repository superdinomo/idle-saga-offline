			<e:layout>
				<e:HorizontalLayout gap="0" verticalAlign="middle"/>
			</e:layout>
		</e:Group>
	</e:Group>
	<e:Group id="group" touchEnabled="false" horizontalCenter="0" bottom="214" height="139">
		<e:Image touchEnabled="false" fillMode="repeat" y="0" source="qy_zycs_tssy" horizontalCenter="0"/>
		<e:Scroller id="scroller" y="41" scaleX="0.7" scaleY="0.7" height="124" horizontalCenter="-7" width="419">
			<e:List id="list" currentState="disabled" useVirtualLayout="false" allowMultipleSelection="true" itemRendererSkinName="ItemSkin">
				<e:layout>
					<e:HorizontalLayout paddingLeft="15" paddingRight="15" paddingTop="15" paddingBottom="15" gap="24"/>
				</e:layout>
				<!--
					
						
						
						
						
					
				-->
			</e:List>
		</e:Scroller>
		<e:Button id="btnLeft" y="62" skinName="Btn0Skin" icon="liuguang_zycs_next" scaleX="-1" x="66"/>
		<e:Button id="btnRight" x="377" y="62" skinName="Btn0Skin" icon="liuguang_zycs_next"/>


	</e:Group>










</e:Skin>