	<w:Config id="1586b1383e3" />
	<e:Group id="groupTime" y="74" right="0" touchEnabled="false">
		<e:Image y="2" touchEnabled="false" fillMode="repeat" x="0" scale9Grid="84,20,25,13" source="em_zycs_jx4"/>

