		<e:Label id="labelNormalAttrNext" text="9999" x="314" fontFamily="SimHei" size="20" lineSpacing="6" visible.max="false" verticalCenter="0"/>
		<e:Label id="labelMax" text="Upper Limit Reached" x="308" fontFamily="SimHei" size="20" lineSpacing="10" visible.act="false" visible.up="false" verticalCenter="0" textColor="0x13ee22"/>
	</e:Group>
	<e:Button id="btnAct" y="953" label="Activate" horizontalCenter="0" visible.up="false" visible.max="false" skinName="BtnMin1_1mid"/>
	<e:Button id="btnUp" y="953" label="Upgrade" horizontalCenter="0" visible.act="false" visible.max="false" skinName="BtnMin1_1mid"/>
	<e:Scroller id="scrollerTab" y="1019" height="64" x="53" width="619">
