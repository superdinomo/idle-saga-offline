<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="HunqiPanelEUI" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"
        xmlns:euiextension="euiextension.*" height="1134" states="act,up,max">
	<e:Image x="0" y="0" height="1134" touchEnabled="false" scale9Grid="88,64,2,3" source="public_zycs_dikuang" width="720"/>
	<e:Image touchEnabled="false" x="13" y="42"  source="hq_zycs_bg_jpg"/>
	<e:Image id="imgIcon" horizontalCenter="0" bottom="723"  source="hq_zycs_sl1_png"/>
	<e:Image y="122" source="hq_zycs_jie" horizontalCenter="-242"/>
	<e:BitmapLabel id="bmpLabelJie" y="160" font="hqnum_fnt" text="2" horizontalCenter="-241.5"/>
	<e:Image y="47" source="public_zycs_jlylk"   horizontalCenter="0"/>
