		<e:layout>
			<e:HorizontalLayout verticalAlign="middle" gap="10"/>
		</e:layout>
	</e:Group>
	<e:Label id="btnFenJie" text="Salvage Eudemon Gear" x="500" y="497" size="20" textAlign="left" fontFamily="黑体" textColor="0x11F51C"/>



	<e:Image y="556" x="46" source="jl_zycs_jjjn"/>


	<e:Scroller id="scroller" y="533" x="122" height="111" width="550">
