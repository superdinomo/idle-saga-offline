<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="HuanShouPanelEUI" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*" xmlns:euiextension="euiextension.*" height="1134" width="720">
    <e:Image x="0" y="0" height="1134" touchEnabled="false" scale9Grid="88,64,2,3" source="public_zycs_dikuang" width="720" />
