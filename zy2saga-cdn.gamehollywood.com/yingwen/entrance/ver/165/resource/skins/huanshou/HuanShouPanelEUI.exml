	<e:Label text="Equip all gear parts before deploying. Stats and skills of deployed Eudemon will take effect" size="18" textAlign="center" fontFamily="Times" touchEnabled="false" x="74" textColor="0xff9b0f" y="800" width="600" wordWrap="true"/>

