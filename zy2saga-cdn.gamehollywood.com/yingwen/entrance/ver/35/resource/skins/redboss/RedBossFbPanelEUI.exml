<?xml version='1.0' encoding='utf-8'?>
<e:Skin class="RedBossFbPanelEUI" height="1280" xmlns:e="http://ns.egret.com/eui"
        xmlns:w="http://ns.egret.com/wing" xmlns:ns1="*"  width="720" >
	<w:Config id="1586b13ea96" />
	<e:Group y="74" right="0" touchEnabled="false">
		<e:Group id="groupShouYi" anchorOffsetY="0" anchorOffsetX="0" touchEnabled="false" y="0" x="0">
		<e:Image id="helpBg" y="2" anchorOffsetY="0" anchorOffsetX="0" touchEnabled="false" fillMode="repeat" x="0" scale9Grid="84,20,25,13" source="em_zycs_jx4"/>
		<e:Label id="helpTxt" y="16" text="Time Left：" fontFamily="Times" size="20" touchEnabled="false" textAlign="left" scaleX="1" scaleY="1" lineSpacing="5" horizontalCenter="-37.5" textColor="0xFFE58B"/>
		<e:BitmapLabel id="bmpTime" y="16" x="111" text="300s" font="rwnum_fnt" letterSpacing="-3"/>
		</e:Group>
	</e:Group>
	<e:Group anchorOffsetX="0" width="201" right="0" bottom="433" height="190">
		<e:Image y="0" x="0" scale9Grid="26,26,13,6" source="sjbs_zycs_k1"/>
		<e:Scroller anchorOffsetY="0" anchorOffsetX="0" scrollPolicyH="off" scrollPolicyV="off" horizontalCenter="0.5" y="36">
			<e:List id="list" itemRendererSkinName="ItemSkin">
		
				
				<e:ArrayCollection>
					<e:Array>
						<e:Object/>
					</e:Array>
				</e:ArrayCollection>	
				<e:layout>
				<e:HorizontalLayout gap="11" paddingLeft="12" paddingRight="12" paddingTop="12" paddingBottom="12"/>
			</e:layout>
			</e:List>
		</e:Scroller>
		<e:Label id="lbDesc" text="Summon Rewards" y="17" fontFamily="Times" size="20" textAlign="center" anchorOffsetY="0" verticalAlign="middle" anchorOffsetX="0" horizontalCenter="0" textColor="0xe3d7be"/>
		<e:Label id="lbName" text="Player Name" y="154" fontFamily="Times" size="20" textAlign="center" anchorOffsetY="0" verticalAlign="middle" anchorOffsetX="0" textColor="0x5AC832" horizontalCenter="0.5"/>
	</e:Group>
</e:Skin>