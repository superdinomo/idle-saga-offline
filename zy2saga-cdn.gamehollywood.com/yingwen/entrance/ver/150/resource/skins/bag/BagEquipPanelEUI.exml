<e:Skin class="BagEquipPanelEUI" xmlns:e="http://ns.egret.com/eui" xmlns:w="http://ns.egret.com/wing"
        xmlns:ns1="*"  width="720" height="1134">
	<w:Config id="1586b1383e3" />
	<e:Image x="0" y="0" height="1134" touchEnabled="false" width="720" scale9Grid="88,64,2,3" source="public_zycs_dikuang"/>
	<e:Image fillMode="scale" source="bag_zycs_diwen" y="219" x="21"/>
	<e:Scroller id="itemScroller" width="720" height="990" y="48" anchorOffsetY="0">
		<e:List id="itemList" scrollEnabled="true" useVirtualLayout="true" itemRendererSkinName="ItemSkin">
		<e:layout>
			<e:TileLayout requestedColumnCount="5" paddingLeft="65" paddingRight="24" paddingTop="21" verticalGap="34" horizontalGap="33"/>
		</e:layout>
		</e:List>
	</e:Scroller>
	<e:Image x="129" y="1051" scale9Grid="5,4,31,24" anchorOffsetX="0" anchorOffsetY="0" source="public_zycs_shurukuang"/>
	<e:Label id="labelBagCapacity" y="1055" text="200/200" fontFamily="Times" size="20" x="121" width="121" textAlign="center" verticalAlign="middle" anchorOffsetX="0" textColor="0xFFFFFF"/>
	<e:Label text="Capacity:" x="24" y="1053" fontFamily="Times" size="24" textColor="0xD6880A"/>
	<e:Label id="labelEmpty" text="There's no item now, please continue playing to get items." y="214" fontFamily="Times" size="24" horizontalCenter="0" textColor="0xe3d7be" visible="false"/>
	<e:Button id="btnAdd" y="1043" icon="public_zycs_jia" skinName="Btn0Skin" x="254"/>






</e:Skin>