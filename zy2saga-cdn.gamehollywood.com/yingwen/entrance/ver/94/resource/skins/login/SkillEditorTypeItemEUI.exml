		<e:TextInput id="tiY" width="48" height="24" x="74" y="162" skinName="TextInputCommonSkin" text="0" x.win="260" y.win="184" width.win="320"/>
		<e:Label text="R " x="127" y="166" size="16" fontFamily="Times" x.win="240" y.win="214"/>
		<e:TextInput id="tiR" width="54" height="24" x="142" y="162" skinName="TextInputCommonSkin" text="0" x.win="260" y.win="211" width.win="320"/>
		<e:Label text="CX" x="16" y="193" size="16" fontFamily="Times" x.win="232" y.win="241"/>
		<e:TextInput id="tiCX" width="60" height="24" x="35" y="189" skinName="TextInputCommonSkin" text="0" x.win="260" y.win="238" width.win="320"/>
		<e:Label text="CY" x="106" y="192" size="16" fontFamily="Times" x.win="232" y.win="270"/>
		<e:TextInput id="tiCY" width="60" height="24" x="125" y="188" skinName="TextInputCommonSkin" text="0" x.win="260" y.win="267" width.win="320"/>
