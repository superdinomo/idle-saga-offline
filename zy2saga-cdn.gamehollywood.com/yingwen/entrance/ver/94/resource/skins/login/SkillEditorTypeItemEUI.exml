		<e:TextInput id="tiPlayCount" width="36" height="24" x="158" y="242" skinName="TextInputCommonSkin" text="1"
		             anchorOffsetX="0"/>

		<e:Label text="X Zoom" x="4" y="220" size="16" fontFamily="Times" x.win="210" y.win="300"/>
		<e:TextInput id="tiScaleX" width="46" height="24" x="48" y="217" skinName="TextInputCommonSkin" text="1"
		             anchorOffsetX="0" x.win="260" y.win="297" width.win="320"/>
		<e:Label text="Y Zoom" x="97" y="220" size="16" fontFamily="Times" x.win="209" y.win="330"/>
		<e:TextInput id="tiScaleY" width="46" height="24" x="147" y="217" skinName="TextInputCommonSkin" text="1" x.win="260" y.win="327" width.win="320"/>
