			<e:TextInput id="tiTweenScaleX" width="44" height="24" x="52" y="44" skinName="TextInputCommonSkin" text="1" anchorOffsetX="0" scaleX="1" scaleY="1"/>
			<e:Label text="Y Zoom" x="104" y="48" size="16" fontFamily="Times"/>


			<e:TextInput id="tiTweenScaleY" width="44" height="24" x="149" y="44" skinName="TextInputCommonSkin" text="1" anchorOffsetX="0" scaleX="1" scaleY="1"/>
