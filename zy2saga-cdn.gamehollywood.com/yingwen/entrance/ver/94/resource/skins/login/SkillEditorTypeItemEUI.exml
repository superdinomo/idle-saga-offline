			<e:RadioButton id="radioIsFollowRot1" label="Yes" x="0" y="0" skinName="RadioButtonEUI" scaleX="0.7" scaleY="0.7"/>
			<e:RadioButton id="radioIsFollowRot2" label="No" x="43" y="0" skinName="RadioButtonEUI" enabled="true" selected="true" scaleX="0.7" scaleY="0.7"/>
		</e:Group>
		<e:Group x="102" y="396" height="22" rotation="0">
			<e:RadioButton id="radioIsSdisMirror1" label="Yes" x="0" y="0" skinName="RadioButtonEUI" scaleX="0.7" scaleY="0.7"/>
			<e:RadioButton id="radioIsSdisMirror2" label="No" x="43" y="0" skinName="RadioButtonEUI" enabled="true" selected="true" scaleX="0.7" scaleY="0.7"/>
		</e:Group>
		<e:Label text="Hand point image" y="401" size="16" fontFamily="Times" x="10"/>
		<e:Label id="labelSDis" text="Graphic Parameters" x="5" y="474" size="16" fontFamily="Times" touchEnabled="true"/>
		<e:TextInput id="tiSDis" width="116" height="24" x="74" y="470" skinName="TextInputCommonSkin" text="0" width.win="499"/>
		<e:TextInput id="tiSDis2" width="60" height="24" x="138" y="470" skinName="TextInputCommonSkin" text="0" visible="false"/>
		<e:Label text="Affected by ATK SPD" y="502" size="16" fontFamily="Times" x="13"/>
		<e:Group x="104" y="500">
			<e:RadioButton id="radioIsRate1" label="Yes" x="0" y="0" skinName="RadioButtonEUI" scaleX="0.7" scaleY="0.7"/>
			<e:RadioButton id="radioIsRate2" label="No" x="46" y="0" skinName="RadioButtonEUI" selected="true" scaleX="0.7" scaleY="0.7"/>
		</e:Group>
		<e:Label text="Floor with direction" x="9" y="525" size="16" fontFamily="Times"/>
		<e:Group x="98" y="524">
			<e:RadioButton id="radioLayer1" label="Bring" x="0" y="0" skinName="RadioButtonEUI" scaleX="0.7" scaleY="0.7"/>
			<e:RadioButton id="radioLayer2" label="Without" x="44" y="0" skinName="RadioButtonEUI" selected="true" scaleX="0.7" scaleY="0.7"/>
		</e:Group>








		<e:Group id="groupPath" x="2" y="591" height="114" width="195">
			<e:Label text="Flight trajectory, effective when the special effect type is flying" y="0" size="12" fontFamily="Times" horizontalCenter="0"/>
			<e:Label id="labelMoverParam" text="Flying Parameters" x="0" y="62" size="16" fontFamily="Times" touchEnabled="true"/>
			<e:TextInput id="tiMoverParam" width="186" height="24" x="3" y="85" skinName="TextInputCommonSkin" text="0"/>






		</e:Group>


		<e:Group id="groupTween" width="200" height="117" y="705" x="0">
			<e:Label text="tween (Zoom,Transparency, Rotation)" y="0" size="16" fontFamily="Times" scaleX="1" scaleY="1" horizontalCenter="0"/>
