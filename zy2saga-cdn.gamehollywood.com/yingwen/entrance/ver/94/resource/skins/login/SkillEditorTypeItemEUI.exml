			<e:Label text="-" x="115" y="21" size="16" fontFamily="Times"/>
			<e:TextInput id="tiTweenStartTime" width="63" height="24" x="43" y="18" skinName="TextInputCommonSkin" text="0" anchorOffsetX="0" scaleX="1" scaleY="1"/>

			<e:TextInput id="tiTweenEndTime" width="63" height="24" x="133" y="17" skinName="TextInputCommonSkin" text="0" anchorOffsetX="0" scaleX="1" scaleY="1"/>
