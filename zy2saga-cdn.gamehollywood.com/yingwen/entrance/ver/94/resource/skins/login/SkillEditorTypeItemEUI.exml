	<e:Image height="100%" x="0" y="0" width="100%" alpha="1" y.win="0" source="public_zycs_greybg2" scale9Grid="20,20,0,0" scale9Grid.win="7,6,5,6"/>
	<e:Group id="group" left="0" top="0" bottom="0" right="0" anchorOffsetX="0">
