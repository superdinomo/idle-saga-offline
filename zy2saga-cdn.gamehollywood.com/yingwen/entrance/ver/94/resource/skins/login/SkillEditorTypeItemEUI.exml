		<e:TextInput id="tiAlpha" width="36" height="24" x="52" y="243" skinName="TextInputCommonSkin" text="1"/>
		<e:Label text="Rotate Angle" x="23" y="271" size="16" fontFamily="Times"/>
		<e:TextInput id="tiRotation" width="80" height="24" x="98" y="269" skinName="TextInputCommonSkin" text="0"/>
		<e:Label text="Towards Target" y="346" size="16" fontFamily="Times" x="9"/>
		<e:Group x="3" y="367" height="22" rotation="0">
			<e:RadioButton id="radioIsRot1" label="Yes" x="0" y="0" skinName="RadioButtonEUI"  scaleX="0.7" scaleY="0.7"/>
			<e:RadioButton id="radioIsRot2" label="No" x="43" y="0" skinName="RadioButtonEUI" enabled="true"
